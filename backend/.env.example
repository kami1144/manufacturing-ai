# LINE Configuration
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_USER_ID=

# AI Configuration
AI_PROVIDER=minimax
AI_API_KEY=your_ai_api_key
AI_MODEL=MiniMax-M2.7

# Vision (MiniMax mmx CLI)
MMX_CLI_PATH=/path/to/mmx

# CORS - 限制为正式域名，多个用逗号分隔
CORS_ORIGINS=https://your-production-domain.com,https://admin.your-domain.com

# Redis Configuration (empty = in-memory mode)
REDIS_HOST=

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Environment
ENVIRONMENT=development
EMBEDDING_GROUP_ID=cp

# Embedding Provider (ollama 或 minimax)
EMBEDDING_PROVIDER=ollama
